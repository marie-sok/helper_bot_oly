OLY_TIMEZONE=Europe/Amsterdam

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/telegram_bot
DATABASE_USERNAME=helper_oly
DATABASE_PASSWORD=replace_me

# Runtime
SERVER_PORT=8082
LOG_LEVEL=INFO
